// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "mode": "auto",
        "fast": false
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "scss": true,
    "vue": true,
    "less": true,
    "sql": true,
    "nginx": true,
    "ini": true,
    "xml": true
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "terminal": {
    "font_size": 15.0,
    "font_family": "Andale Mono",
    "font_fallbacks": [
      "monospace"
    ]
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "buffer_font_family": "Menlo",
  "file_types": {
    "c": [
      ".htaccess"
    ]
  },
  "show_whitespaces": "none",
  "show_edit_predictions": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "right",
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev",
        "raw.githubusercontent.com",
        "api.github.com"
      ]
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.4",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dark Modern Blue",
  },
}
